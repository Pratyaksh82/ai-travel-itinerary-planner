# AI Travel Itinerary Planner Environment Configuration
ENVIRONMENT=development
PORT=8000

# LLM Providers (Optional - high-fidelity synthesis engine runs offline if not provided)
GROQ_API_KEY=gsk_your_groq_api_key_here
